        "type": "string",
        "enum": [
          "automatic",
          "radio"
        ]
      },
      "compact": {
        "type": "boolean"
      },
      "slider": {
        "type": "boolean"
      },
      "flatLayout": {
        "type": "boolean"
      },
      "showExtra": {
        "type": "boolean"
      },
      "useAlternate": {
        "type": "boolean"
      },
      "hideNameInHideMode": {
        "type": "boolean"
      },
      "amountLabel": {
        "type": "string"
      },
      "invalidLabel": {
        "type": "boolean"
      }
    },
    "required": [
