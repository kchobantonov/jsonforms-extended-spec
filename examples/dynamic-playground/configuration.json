      "readonly",
      "presentation",
      "compact"
    ]
  },
  "data": {
    "label": "Subscription plan",
    "readonly": false,
    "presentation": "automatic",
    "compact": false,
    "slider": false,
    "flatLayout": false,
    "showExtra": false,
    "useAlternate": false,
    "hideNameInHideMode": false,
