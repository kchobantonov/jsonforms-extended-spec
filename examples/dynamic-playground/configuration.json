{
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "readonly": {
        "type": "boolean"
      },
      "presentation": {
        "type": "string",
        "enum": [
          "automatic",
          "radio"
        ]
      },
      "compact": {
        "type": "boolean"
      },
      "slider": {
        "type": "boolean"
      },
      "flatLayout": {
        "type": "boolean"
      },
      "showExtra": {
        "type": "boolean"
      },
      "useAlternate": {
        "type": "boolean"
      },
      "hideNameInHideMode": {
        "type": "boolean"
      },
      "amountLabel": {
        "type": "string"
      },
      "invalidLabel": {
        "type": "boolean"
      },
      "wholeMemberDetail": {
        "type": "boolean"
      }
    },
    "required": [
      "label",
      "readonly",
      "presentation",
      "compact"
    ]
  },
  "data": {
    "label": "",
    "readonly": false,
    "presentation": "automatic",
    "compact": false,
    "slider": false,
    "flatLayout": false,
    "showExtra": false,
    "useAlternate": false,
    "hideNameInHideMode": false,
    "amountLabel": "",
    "invalidLabel": false,
    "wholeMemberDetail": false
  },
  "uischema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/label",
        "label": "Preview label",
        "i18n": "dynamicPlayground.previewLabel"
      },
      {
        "type": "Control",
        "scope": "#/properties/readonly",
        "label": "Preview readonly",
        "i18n": "dynamicPlayground.previewReadonly"
      },
      {
        "type": "Control",
        "scope": "#/properties/presentation",
        "label": "Preview presentation",
        "i18n": "dynamicPlayground.previewPresentation"
      },
      {
        "type": "Control",
        "scope": "#/properties/compact",
        "label": "Compact preview spacing",
        "i18n": "dynamicPlayground.compactSpacing"
      },
      {
        "type": "Group",
        "label": "Advanced",
        "i18n": "dynamicAdvanced.advanced",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/slider",
            "i18n": "dynamicAdvanced.useSlider",
            "label": "Use slider editor"
          },
          {
            "type": "Control",
            "scope": "#/properties/flatLayout",
            "i18n": "dynamicAdvanced.flatLayout",
            "label": "Use flat extra layout"
          },
          {
            "type": "Control",
            "scope": "#/properties/showExtra",
            "i18n": "dynamicAdvanced.showExtra",
            "label": "Show extra field"
          },
          {
            "type": "Control",
            "scope": "#/properties/useAlternate",
            "i18n": "dynamicAdvanced.editAlternate",
            "label": "Edit alternate name"
          },
          {
            "type": "Control",
            "scope": "#/properties/hideNameInHideMode",
            "i18n": "dynamicAdvanced.hideName",
            "label": "Hide name when mode is hide"
          },
          {
            "type": "Control",
            "scope": "#/properties/amountLabel",
            "i18n": "dynamicAdvanced.amountLabel",
            "label": "Amount label"
          },
          {
            "type": "Control",
            "scope": "#/properties/invalidLabel",
            "i18n": "dynamicAdvanced.invalidLabel",
            "label": "Try invalid label binding"
          },
          {
            "type": "Control",
            "scope": "#/properties/wholeMemberDetail",
            "label": "Replace whole member detail",
            "i18n": "dynamicAdvanced.wholeMemberDetail"
          }
        ]
      }
    ]
  }
